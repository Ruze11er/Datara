{
  "name": "datara",
  "productName": "Datara",
  "version": "0.1.0",
  "description": "Offline learning and practice app for aspiring data analysts",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "engines": "node scripts/prepare-engines.mjs",
    "dev": "npm run engines && electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-content.ts",
    "dataset": "node scripts/generate-dataset.mjs",
    "build": "npm run engines && npm run typecheck && npm run verify && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "selftest": "node scripts/selftest.mjs",
    "icons": "electron scripts/make-icons.mjs",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "codemirror": "^6.0.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.62.0",
    "marked": "^18.1.2",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sql.js": "^1.15.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "yaml": "^2.9.1"
  }
}
